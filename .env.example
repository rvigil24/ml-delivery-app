# Configuración no secreta; exportar las variables necesarias en el proceso.
# La API no carga automáticamente un archivo .env.
# Bucket existente: no crear, borrar ni modificar desde esta estructura.
AWS_REGION=us-east-1
S3_BUCKET=ml-kodigo-resources
# Autenticación futura: perfil local AWS CLI o rol IAM, fuera del repositorio.

# T30: directorio de un bundle T19 propio de confianza. Vacío: modelo no disponible.
DELIVERY_MODEL_DIR=

# T32: MongoDB Atlas Free sobre AWS us-east-1; URI privada fuera de Git.
# Exportar ambas variables. Inicializar esquema explícitamente antes de usar la API.
MONGODB_URI=
MONGODB_DATABASE=

# T33: perfil local opcional; en AWS se podrán usar roles IAM.
DELIVERY_AWS_PROFILE=
S3_ENDPOINT_URL=https://s3.us-east-1.amazonaws.com
# Alternativa a DELIVERY_MODEL_DIR: manifiesto propio fijado por hash/tamaño.
DELIVERY_MODEL_MANIFEST_KEY=
DELIVERY_MODEL_MANIFEST_SHA256=
DELIVERY_MODEL_MANIFEST_SIZE=

# Demostración completa optativa; habilitar únicamente en un entorno de demo.
DELIVERY_DEMO_ENABLED=0

# Modelos entrenados ETA/riesgo por distancia y plazo prometido.
DELIVERY_MODEL_V2_DIR=
# Alternativa S3: dejar DELIVERY_MODEL_V2_DIR vacío y fijar el manifiesto v2.
# En AWS dejar DELIVERY_AWS_PROFILE vacío para usar el rol IAM del servicio.
DELIVERY_MODEL_V2_MANIFEST_KEY=
DELIVERY_MODEL_V2_MANIFEST_SHA256=
DELIVERY_MODEL_V2_MANIFEST_SIZE=
